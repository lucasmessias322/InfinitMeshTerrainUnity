uint Mix(uint hash, uint value)
{
    hash ^= value;
    hash *= 16777619u;
    return hash;
}

uint Hash(uint value)
{
    value ^= value >> 16;
    value *= 0x7feb352du;
    value ^= value >> 15;
    value *= 0x846ca68bu;
    value ^= value >> 16;
    return value;
}

uint Hash6(int a, int b, int c, int d, int e, int f)
{
    uint hash = 2166136261u;
    hash = Mix(hash, (uint)a);
    hash = Mix(hash, (uint)b);
    hash = Mix(hash, (uint)c);
    hash = Mix(hash, (uint)d);
    hash = Mix(hash, (uint)e);
    hash = Mix(hash, (uint)f);
    return Hash(hash);
}

float Hash01(uint value)
{
    return (Hash(value) >> 8) * (1.0 / 16777216.0);
}

uint PackUnorm8(float value)
{
    return (uint)round(saturate(value) * 255.0);
}

uint PackColor(float3 color)
{
    return PackUnorm8(color.r)
        | (PackUnorm8(color.g) << 8)
        | (PackUnorm8(color.b) << 16);
}

uint PackColorWidth(float3 color, float width)
{
    float widthScale = max(_GrassPackedWidthScale, 0.0001);
    return PackColor(color) | (PackUnorm8(width / widthScale) << 24);
}

uint PackNormalYaw(float3 normalWS, float yaw)
{
    float3 normal = normalize(normalWS + float3(0.0001, 0.0001, 0.0001));
    uint normalX = PackUnorm8(normal.x * 0.5 + 0.5);
    uint normalZ = PackUnorm8(normal.z * 0.5 + 0.5);
    float yaw01 = frac(yaw * (1.0 / 6.2831855));
    uint packedYaw = (uint)round(saturate(yaw01) * 65535.0);
    return normalX | (normalZ << 8) | (packedYaw << 16);
}

float UnpackUnorm8(uint packed)
{
    return (float)(packed & 255u) * (1.0 / 255.0);
}

float UnpackWidth(uint packedColorWidth)
{
    return max(0.01, UnpackUnorm8(packedColorWidth >> 24) * max(_GrassPackedWidthScale, 0.01));
}

float3 DecodeNormal(uint packedNormalYaw)
{
    float normalX = UnpackUnorm8(packedNormalYaw) * 2.0 - 1.0;
    float normalZ = UnpackUnorm8(packedNormalYaw >> 8) * 2.0 - 1.0;
    float normalY = sqrt(saturate(1.0 - normalX * normalX - normalZ * normalZ));
    return normalize(float3(normalX, normalY, normalZ) + float3(0.0001, 0.0001, 0.0001));
}

float SmoothStep01(float edge0, float edge1, float value)
{
    float t = saturate((value - edge0) / max(edge1 - edge0, 0.0001));
    return t * t * (3.0 - 2.0 * t);
}

float2 Mod289(float2 x)
{
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

float3 Mod289(float3 x)
{
    return x - floor(x * (1.0 / 289.0)) * 289.0;
}

float3 Permute(float3 x)
{
    return Mod289(((x * 34.0) + 10.0) * x);
}

float SimplexNoise(float2 v)
{
    const float4 C = float4(0.211324865405187, 0.366025403784439, -0.577350269189626, 0.024390243902439);
    float2 i = floor(v + dot(v, C.yy));
    float2 x0 = v - i + dot(i, C.xx);
    float2 i1 = x0.x > x0.y ? float2(1.0, 0.0) : float2(0.0, 1.0);
    float4 x12 = x0.xyxy + C.xxzz;
    x12.xy -= i1;
    i = Mod289(i);
    float3 p = Permute(Permute(i.y + float3(0.0, i1.y, 1.0)) + i.x + float3(0.0, i1.x, 1.0));
    float3 m = max(0.5 - float3(dot(x0, x0), dot(x12.xy, x12.xy), dot(x12.zw, x12.zw)), 0.0);
    m = m * m;
    m = m * m;
    float3 x = 2.0 * frac(p * C.www) - 1.0;
    float3 h = abs(x) - 0.5;
    float3 ox = floor(x + 0.5);
    float3 a0 = x - ox;
    m *= 1.79284291400159 - 0.85373472095314 * (a0 * a0 + h * h);
    float3 g;
    g.x = a0.x * x0.x + h.x * x0.y;
    g.y = a0.y * x12.x + h.y * x12.y;
    g.z = a0.z * x12.z + h.z * x12.w;
    return 130.0 * dot(m, g);
}

void AddWeight(inout float4 map0, inout float4 map1, int channel, float value)
{
    switch (channel)
    {
        case 1:
            map0.y += value;
            break;
        case 2:
            map0.z += value;
            break;
        case 3:
            map0.w += value;
            break;
        case 4:
            map1.x += value;
            break;
        case 5:
            map1.y += value;
            break;
        case 6:
            map1.z += value;
            break;
        case 7:
            map1.w += value;
            break;
        default:
            map0.x += value;
            break;
    }
}

float ReadWeight(float4 map0, float4 map1, int channel)
{
    switch (channel)
    {
        case 1:
            return map0.y;
        case 2:
            return map0.z;
        case 3:
            return map0.w;
        case 4:
            return map1.x;
        case 5:
            return map1.y;
        case 6:
            return map1.z;
        case 7:
            return map1.w;
        default:
            return map0.x;
    }
}

void NormalizeWeights(inout float4 map0, inout float4 map1)
{
    float sum = map0.x + map0.y + map0.z + map0.w + map1.x + map1.y + map1.z + map1.w;
    if (sum > 0.0001)
    {
        map0 /= sum;
        map1 /= sum;
    }
}

float EvaluateSplatWeight(float height, float slopeAngle, int channel)
{
    if (_GrassTerrainLayerCount <= 0)
    {
        return channel == 0 ? 1.0 : 0.0;
    }

    float4 map0 = 0.0;
    float4 map1 = 0.0;
    AddWeight(map0, map1, _GrassTerrainLayers[0].channel, 1.0);

    [loop]
    for (int i = 1; i < _GrassTerrainLayerCount; i++)
    {
        GrassTerrainLayer layer = _GrassTerrainLayers[i];
        float blend = SmoothStep01(layer.startHeight, layer.startHeight + max(0.0001, layer.blendRange), height);
        map0 *= 1.0 - blend;
        map1 *= 1.0 - blend;
        AddWeight(map0, map1, layer.channel, blend);
    }

    NormalizeWeights(map0, map1);

    if (_GrassSlopeEnabled != 0)
    {
        float slopeBlend = SmoothStep01(_GrassSlopeStartAngle, _GrassSlopeFullAngle, slopeAngle);
        float rockAmount = saturate(slopeBlend * _GrassSlopeStrength);
        if (rockAmount > 0.0001)
        {
            map0 *= 1.0 - rockAmount;
            map1 *= 1.0 - rockAmount;
            AddWeight(map0, map1, _GrassSlopeChannel, rockAmount);
            NormalizeWeights(map0, map1);
        }
    }

    return ReadWeight(map0, map1, channel);
}

float EvaluateLayerCoverage(float height, float slopeAngle)
{
    float weight = EvaluateSplatWeight(height, slopeAngle, _GrassChannel);
    return saturate((weight - _GrassLayerThreshold) / max(1.0 - _GrassLayerThreshold, 0.0001));
}

float EvaluateHeightGate(float height)
{
    float lower = SmoothStep01(_GrassMinHeight, _GrassMinHeight + _GrassHeightFadeRange, height);
    float upper = 1.0 - SmoothStep01(_GrassMaxHeight - _GrassHeightFadeRange, _GrassMaxHeight, height);
    return saturate(lower * upper);
}

float EvaluateSlopeGate(float slopeAngle)
{
    float lower = SmoothStep01(_GrassMinSlopeAngle - _GrassSlopeFadeRange, _GrassMinSlopeAngle, slopeAngle);
    float upper = 1.0 - SmoothStep01(_GrassMaxSlopeAngle, _GrassMaxSlopeAngle + _GrassSlopeFadeRange, slopeAngle);
    return saturate(lower * upper);
}

float EvaluateCoverageNoise(float2 worldXZ)
{
    if (_GrassCoverageNoiseFrequency <= 0.0 || _GrassCoverageNoiseStrength <= 0.0)
    {
        return 1.0;
    }

    float2 seedOffset = float2(_GrassSeed * 11.17, _GrassSeed * -7.31);
    float noiseValue = saturate(SimplexNoise((worldXZ + seedOffset) * _GrassCoverageNoiseFrequency) * 0.5 + 0.5);
    return lerp(1.0, saturate(noiseValue * 1.8), _GrassCoverageNoiseStrength);
}

float SampleBiomeFractalValueNoise(float2 worldXZ, int salt);

float SampleBiomeNoise(float2 worldXZ)
{
    return SampleBiomeFractalValueNoise(worldXZ, -10007);
}

float EvaluateBiomeDistance(float2 worldXZ)
{
    float distanceFromCenter = length(worldXZ);
    if (_GrassBiomeUseNoise == 0 || _GrassBiomeNoiseAmplitude <= 0.0 || _GrassBiomeNoiseFrequency <= 0.0)
    {
        return distanceFromCenter;
    }

    return max(0.0, distanceFromCenter + SampleBiomeNoise(worldXZ) * _GrassBiomeNoiseAmplitude);
}

float GetBiomeSelectionWeight(float4 distanceRange)
{
    return max(0.0, distanceRange.z);
}

int GetBiomeSeedIndex(float4 distanceRange, int fallbackIndex)
{
    return distanceRange.w >= 0.0 ? (int)round(distanceRange.w) : fallbackIndex;
}

uint BiomeNoiseHash(int x, int z, int seed, int salt, int octave)
{
    uint hash = 2166136261u;
    hash = Mix(hash, (uint)x);
    hash = Mix(hash, (uint)z);
    hash = Mix(hash, (uint)seed);
    hash = Mix(hash, (uint)salt);
    hash = Mix(hash, (uint)octave);
    return hash;
}

float SampleBiomeValueNoise(float2 sample, int seed, int salt, int octave)
{
    int x0 = (int)floor(sample.x);
    int z0 = (int)floor(sample.y);
    int x1 = x0 + 1;
    int z1 = z0 + 1;
    float2 t = float2(sample.x - x0, sample.y - z0);
    t = t * t * (3.0 - 2.0 * t);

    float v00 = Hash01(BiomeNoiseHash(x0, z0, seed, salt, octave)) * 2.0 - 1.0;
    float v10 = Hash01(BiomeNoiseHash(x1, z0, seed, salt, octave)) * 2.0 - 1.0;
    float v01 = Hash01(BiomeNoiseHash(x0, z1, seed, salt, octave)) * 2.0 - 1.0;
    float v11 = Hash01(BiomeNoiseHash(x1, z1, seed, salt, octave)) * 2.0 - 1.0;

    return lerp(lerp(v00, v10, t.x), lerp(v01, v11, t.x), t.y);
}

float SampleBiomeFractalValueNoise(float2 worldXZ, int salt)
{
    float frequency = max(0.000001, _GrassBiomeNoiseFrequency);
    float amplitude = 1.0;
    float value = 0.0;
    float amplitudeSum = 0.0;
    int octaveCount = min(max(_GrassBiomeNoiseOctaves, 1), 8);
    float2 seedOffset = _GrassBiomeNoiseOffset.xy + float2(
        _GrassBiomeSeed * 17.13,
        _GrassBiomeSeed * -31.71);

    [loop]
    for (int octave = 0; octave < octaveCount; octave++)
    {
        value += SampleBiomeValueNoise((worldXZ + seedOffset) * frequency, _GrassBiomeSeed, salt, octave) * amplitude;
        amplitudeSum += amplitude;
        amplitude *= saturate(_GrassBiomeNoisePersistence);
        frequency *= max(1.0, _GrassBiomeNoiseLacunarity);
    }

    return amplitudeSum > 0.0001 ? value / amplitudeSum : 0.0;
}

float SampleBiomeSelectionNoise(float2 worldXZ, int biomeIndex)
{
    return SampleBiomeFractalValueNoise(worldXZ, biomeIndex);
}

float EvaluateBiomeSelectionScore(float2 worldXZ, int biomeIndex, float selectionWeight)
{
    float score = _GrassBiomeUseNoise != 0
        ? SampleBiomeSelectionNoise(worldXZ, biomeIndex)
        : 0.0;
    float weightBias = log(max(0.0001, selectionWeight)) * 0.35;
    return score + weightBias + biomeIndex * 0.00001;
}

float DistanceToRange(float value, float minDistance, float maxDistance)
{
    if (value < minDistance)
    {
        return minDistance - value;
    }

    return value > maxDistance ? value - maxDistance : 0.0;
}

float SmoothBiomeBlend01(float value)
{
    float t = saturate(value);
    return t * t * (3.0 - 2.0 * t);
}

float GetBiomeSelectionBlendWidth()
{
    if (_GrassBiomeUseNoise == 0 || _GrassBiomeBlendDistance <= 0.0001)
    {
        return 0.0;
    }

    return clamp(_GrassBiomeBlendDistance * max(0.000001, _GrassBiomeNoiseFrequency), 0.02, 0.5);
}

int ResolveBiomeIndex(float2 worldXZ, float biomeDistance)
{
    int biomeIndex = -1;
    float bestScore = -3.402823e38;
    float nearestDistance = 3.402823e38;
    int nearestIndex = -1;

    [loop]
    for (int i = 0; i < _GrassBiomeCount; i++)
    {
        BiomeData biome = _GrassBiomes[i];
        float minDistance = max(0.0, biome.distanceRange.x);
        float maxDistance = max(minDistance, biome.distanceRange.y);
        float selectionWeight = GetBiomeSelectionWeight(biome.distanceRange);
        if (selectionWeight <= 0.0)
        {
            continue;
        }

        float distanceToRange = DistanceToRange(biomeDistance, minDistance, maxDistance);
        if (distanceToRange < nearestDistance)
        {
            nearestDistance = distanceToRange;
            nearestIndex = i;
        }

        if (distanceToRange <= 0.0001)
        {
            int biomeSeedIndex = GetBiomeSeedIndex(biome.distanceRange, i);
            float score = EvaluateBiomeSelectionScore(worldXZ, biomeSeedIndex, selectionWeight);
            if (score > bestScore || (abs(score - bestScore) <= 0.0001 && i > biomeIndex))
            {
                biomeIndex = i;
                bestScore = score;
            }
        }
    }

    return biomeIndex >= 0 ? biomeIndex : nearestIndex;
}

BiomeGrassSample CreateDefaultBiomeGrassSample(float colorVariation)
{
    BiomeGrassSample sample;
    sample.grassBaseColor = float3(1.0, 1.0, 1.0);
    sample.grassTipColor = float3(1.0, 1.0, 1.0);
    sample.densityMultiplier = 1.0;
    sample.bladeHeightMultiplier = 1.0;
    sample.bladeWidthMultiplier = 1.0;
    sample.colorVariation = saturate(colorVariation);
    return sample;
}

BiomeGrassSample CreateBiomeGrassSample(BiomeData biome)
{
    BiomeGrassSample sample;
    sample.grassBaseColor = max(float3(0.0, 0.0, 0.0), biome.grassBaseColor.rgb);
    sample.grassTipColor = max(float3(0.0, 0.0, 0.0), biome.grassTipColor.rgb);
    sample.densityMultiplier = max(0.0, biome.grassSettings.x);
    sample.bladeHeightMultiplier = max(0.01, biome.grassSettings.y);
    sample.bladeWidthMultiplier = max(0.01, biome.grassSettings.z);
    sample.colorVariation = saturate(biome.grassSettings.w);
    return sample;
}

void BlendGrassBiomeColor(inout BiomeGrassSample sample, BiomeGrassSample secondarySample, float weight)
{
    float blendWeight = saturate(weight);
    sample.grassBaseColor = lerp(sample.grassBaseColor, secondarySample.grassBaseColor, blendWeight);
    sample.grassTipColor = lerp(sample.grassTipColor, secondarySample.grassTipColor, blendWeight);
    sample.colorVariation = lerp(sample.colorVariation, secondarySample.colorVariation, blendWeight);
}

void TrackGrassBiomeCandidate(
    float2 worldXZ,
    float biomeDistance,
    int candidateIndex,
    float4 distanceRange,
    float blendDistance,
    inout int primaryIndex,
    inout float bestScore,
    inout int secondaryIndex,
    inout float secondScore,
    inout int nearestIndex,
    inout float nearestDistance,
    inout int nearestTransitionIndex,
    inout float nearestTransitionDistance)
{
    float minDistance = max(0.0, distanceRange.x);
    float maxDistance = max(minDistance, distanceRange.y);
    float selectionWeight = GetBiomeSelectionWeight(distanceRange);
    if (selectionWeight <= 0.0)
    {
        return;
    }

    float distanceToRange = DistanceToRange(biomeDistance, minDistance, maxDistance);
    if (distanceToRange < nearestDistance)
    {
        nearestDistance = distanceToRange;
        nearestIndex = candidateIndex;
    }

    if (distanceToRange <= 0.0001)
    {
        int biomeSeedIndex = GetBiomeSeedIndex(distanceRange, candidateIndex);
        float score = EvaluateBiomeSelectionScore(worldXZ, biomeSeedIndex, selectionWeight);
        if (score > bestScore || (abs(score - bestScore) <= 0.0001 && candidateIndex > primaryIndex))
        {
            secondaryIndex = primaryIndex;
            secondScore = bestScore;
            primaryIndex = candidateIndex;
            bestScore = score;
        }
        else if (score > secondScore || (abs(score - secondScore) <= 0.0001 && candidateIndex > secondaryIndex))
        {
            secondaryIndex = candidateIndex;
            secondScore = score;
        }
    }
    else if (blendDistance > 0.0001
        && distanceToRange < nearestTransitionDistance
        && distanceToRange <= blendDistance)
    {
        nearestTransitionDistance = distanceToRange;
        nearestTransitionIndex = candidateIndex;
    }
}

void ApplySmoothBiomeGrassColor(
    inout BiomeGrassSample sample,
    int colorPrimaryIndex,
    int colorSecondaryIndex,
    float colorSecondScore,
    float colorBestScore,
    int colorNearestIndex,
    int colorNearestTransitionIndex,
    float colorNearestTransitionDistance,
    float blendDistance)
{
    int primaryIndex = colorPrimaryIndex;
    if (primaryIndex < 0)
    {
        primaryIndex = colorNearestIndex;
    }

    if (primaryIndex < 0)
    {
        return;
    }

    BiomeGrassSample colorSample = CreateBiomeGrassSample(_GrassBiomes[primaryIndex]);
    sample.grassBaseColor = colorSample.grassBaseColor;
    sample.grassTipColor = colorSample.grassTipColor;
    sample.colorVariation = colorSample.colorVariation;

    int blendIndex = -1;
    float blendWeight = 0.0;
    if (blendDistance > 0.0001 && colorSecondaryIndex >= 0)
    {
        float selectionBlendWidth = GetBiomeSelectionBlendWidth();
        if (selectionBlendWidth > 0.0001)
        {
            float scoreGap = max(0.0, colorBestScore - colorSecondScore);
            float scoreBlend = 0.5 - scoreGap / (selectionBlendWidth * 2.0);
            if (scoreBlend > blendWeight)
            {
                blendIndex = colorSecondaryIndex;
                blendWeight = saturate(scoreBlend);
            }
        }
    }

    if (blendDistance > 0.0001
        && colorNearestTransitionIndex >= 0
        && colorNearestTransitionIndex != primaryIndex)
    {
        float t = saturate(colorNearestTransitionDistance / blendDistance);
        float rangeBlend = (1.0 - SmoothBiomeBlend01(t)) * 0.5;
        if (rangeBlend > blendWeight)
        {
            blendIndex = colorNearestTransitionIndex;
            blendWeight = rangeBlend;
        }
    }

    if (blendIndex >= 0 && blendWeight > 0.0001)
    {
        BlendGrassBiomeColor(sample, CreateBiomeGrassSample(_GrassBiomes[blendIndex]), blendWeight);
    }
}

BiomeGrassSample ResolveBiomeGrassSample(
    float2 placementWorldXZ,
    float placementBiomeDistance,
    float2 colorWorldXZ,
    float colorBiomeDistance)
{
    int placementPrimaryIndex = -1;
    int placementSecondaryIndex = -1;
    float placementBestScore = -3.402823e38;
    float placementSecondScore = -3.402823e38;
    float placementNearestDistance = 3.402823e38;
    int placementNearestIndex = -1;
    float placementNearestTransitionDistance = 3.402823e38;
    int placementNearestTransitionIndex = -1;
    int colorPrimaryIndex = -1;
    int colorSecondaryIndex = -1;
    float colorBestScore = -3.402823e38;
    float colorSecondScore = -3.402823e38;
    float colorNearestDistance = 3.402823e38;
    int colorNearestIndex = -1;
    float colorNearestTransitionDistance = 3.402823e38;
    int colorNearestTransitionIndex = -1;
    float blendDistance = max(0.0, _GrassBiomeBlendDistance);

    [loop]
    for (int i = 0; i < _GrassBiomeCount; i++)
    {
        float4 distanceRange = _GrassBiomes[i].distanceRange;
        TrackGrassBiomeCandidate(
            placementWorldXZ,
            placementBiomeDistance,
            i,
            distanceRange,
            0.0,
            placementPrimaryIndex,
            placementBestScore,
            placementSecondaryIndex,
            placementSecondScore,
            placementNearestIndex,
            placementNearestDistance,
            placementNearestTransitionIndex,
            placementNearestTransitionDistance);
        TrackGrassBiomeCandidate(
            colorWorldXZ,
            colorBiomeDistance,
            i,
            distanceRange,
            blendDistance,
            colorPrimaryIndex,
            colorBestScore,
            colorSecondaryIndex,
            colorSecondScore,
            colorNearestIndex,
            colorNearestDistance,
            colorNearestTransitionIndex,
            colorNearestTransitionDistance);
    }

    if (placementPrimaryIndex < 0)
    {
        placementPrimaryIndex = placementNearestIndex;
    }

    if (placementPrimaryIndex < 0)
    {
        return CreateDefaultBiomeGrassSample(0.0);
    }

    BiomeGrassSample sample = CreateBiomeGrassSample(_GrassBiomes[placementPrimaryIndex]);
    ApplySmoothBiomeGrassColor(
        sample,
        colorPrimaryIndex,
        colorSecondaryIndex,
        colorSecondScore,
        colorBestScore,
        colorNearestIndex,
        colorNearestTransitionIndex,
        colorNearestTransitionDistance,
        blendDistance);
    return sample;
}

float2 QuantizeBiomeGrassWorldXZ(float2 worldXZ)
{
    if (_GrassTerrainChunkSize <= 0.0001 || _GrassBiomeSampleSpacing <= 0.0001)
    {
        return worldXZ;
    }

    float2 chunkCoord = floor(worldXZ / _GrassTerrainChunkSize);
    float2 chunkOrigin = chunkCoord * _GrassTerrainChunkSize;
    float2 local = worldXZ - chunkOrigin;
    return chunkOrigin + round(local / _GrassBiomeSampleSpacing) * _GrassBiomeSampleSpacing;
}

BiomeGrassSample EvaluateBiomeGrassSample(float2 worldXZ)
{
    if (_GrassBiomeCount <= 0)
    {
        return CreateDefaultBiomeGrassSample(0.0);
    }

    float2 placementWorldXZ = QuantizeBiomeGrassWorldXZ(worldXZ);
    float placementBiomeDistance = EvaluateBiomeDistance(placementWorldXZ);
    float colorBiomeDistance = _GrassBiomeBlendDistance > 0.0001
        ? EvaluateBiomeDistance(worldXZ)
        : placementBiomeDistance;
    return ResolveBiomeGrassSample(placementWorldXZ, placementBiomeDistance, worldXZ, colorBiomeDistance);
}

void SampleSurface(float2 local, out float3 positionWS, out float3 normalWS)
{
    float u = saturate(local.x / _GrassChunkSize);
    float v = saturate(local.y / _GrassChunkSize);
    float gridX = u * (_GrassResolution - 1);
    float gridZ = v * (_GrassResolution - 1);
    int x0 = clamp((int)floor(gridX), 0, _GrassResolution - 1);
    int z0 = clamp((int)floor(gridZ), 0, _GrassResolution - 1);
    int x1 = min(x0 + 1, _GrassResolution - 1);
    int z1 = min(z0 + 1, _GrassResolution - 1);
    float tx = gridX - x0;
    float tz = gridZ - z0;

    int i00 = z0 * _GrassResolution + x0;
    int i10 = z0 * _GrassResolution + x1;
    int i01 = z1 * _GrassResolution + x0;
    int i11 = z1 * _GrassResolution + x1;

    float3 n00 = _GrassSurfaceNormals[i00];
    float3 n10 = _GrassSurfaceNormals[i10];
    float3 n01 = _GrassSurfaceNormals[i01];
    float3 n11 = _GrassSurfaceNormals[i11];

    float h00 = _GrassSurfaceVertices[i00].y;
    float h10 = _GrassSurfaceVertices[i10].y;
    float h01 = _GrassSurfaceVertices[i01].y;
    float h11 = _GrassSurfaceVertices[i11].y;
    float surfaceHeight;
    float3 normalBlend;

    if (tz >= tx)
    {
        float w00 = 1.0 - tz;
        float w01 = tz - tx;
        float w11 = tx;
        surfaceHeight = h00 * w00 + h01 * w01 + h11 * w11;
        normalBlend = n00 * w00 + n01 * w01 + n11 * w11;
    }
    else
    {
        float w00 = 1.0 - tx;
        float w10 = tx - tz;
        float w11 = tz;
        surfaceHeight = h00 * w00 + h10 * w10 + h11 * w11;
        normalBlend = n00 * w00 + n10 * w10 + n11 * w11;
    }

    if (dot(normalBlend, normalBlend) < 0.0001)
    {
        normalWS = float3(0.0, 1.0, 0.0);
    }
    else
    {
        normalWS = normalize(normalBlend);
    }

    positionWS = float3(_GrassChunkOrigin.x + local.x, surfaceHeight, _GrassChunkOrigin.y + local.y);
}

[numthreads(8, 8, 1)]
void GenerateGrassInstances(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_GrassCellsPerAxis
        || id.y >= (uint)_GrassCellsPerAxis
        || _GrassCapacity <= 0
        || _GrassResolution < 2)
    {
        return;
    }

    float cellSize = _GrassChunkSize / max(1, _GrassCellsPerAxis);
    bool hasBiomes = _GrassBiomeCount > 0;
    float densityCapacityMultiplier = hasBiomes ? max(0.0, _GrassMaxBiomeDensityMultiplier) : 1.0;
    float expectedPerCell = _GrassDensityPerSquareMeter * densityCapacityMultiplier * cellSize * cellSize;
    if (expectedPerCell <= 0.0)
    {
        return;
    }

    float minBladeWidth = max(0.005, min(_GrassBladeSizeRange.x, _GrassBladeSizeRange.z));
    float minBladeHeight = max(0.01, min(_GrassBladeSizeRange.y, _GrassBladeSizeRange.w));
    float maxBladeWidth = max(minBladeWidth, max(_GrassBladeSizeRange.x, _GrassBladeSizeRange.z));
    float maxBladeHeight = max(minBladeHeight, max(_GrassBladeSizeRange.y, _GrassBladeSizeRange.w));

    int x = (int)id.x;
    int z = (int)id.y;
    uint cellHash = Hash6(_GrassChunkCoordX, _GrassChunkCoordZ, x, z, _GrassTerrainSeed, _GrassSeed);
    int candidateCount = (int)floor(expectedPerCell);
    float fractional = expectedPerCell - candidateCount;
    if (Hash01(cellHash + 0x6d2b79f5u) < fractional)
    {
        candidateCount++;
    }

    candidateCount = min(candidateCount, _GrassMaxInstancesPerCell);
    [loop]
    for (int candidate = 0; candidate < candidateCount; candidate++)
    {
        uint instanceHash = Hash6((int)cellHash, candidate, x * 73856093, z * 19349663, _GrassSeed, _GrassTerrainSeed);
        float2 jitter = float2(
            Hash01(instanceHash + 0x9e3779b9u),
            Hash01(instanceHash + 0xbb67ae85u));
        float2 centeredJitter = (jitter - 0.5) * _GrassJitter + 0.5;
        float2 local = (float2(x, z) + centeredJitter) * cellSize;
        local = clamp(local, float2(0.001, 0.001), float2(_GrassChunkSize - 0.001, _GrassChunkSize - 0.001));

        float3 positionWS;
        float3 normalWS;
        SampleSurface(local, positionWS, normalWS);

        BiomeGrassSample biomeGrass = CreateDefaultBiomeGrassSample(_GrassColorVariation);
        if (hasBiomes)
        {
            biomeGrass = EvaluateBiomeGrassSample(positionWS.xz);
        }
        float slopeAngle = acos(clamp(normalWS.y, -1.0, 1.0)) * 57.29578;
        float coverage = EvaluateLayerCoverage(positionWS.y, slopeAngle);
        coverage *= EvaluateHeightGate(positionWS.y);
        coverage *= EvaluateSlopeGate(slopeAngle);
        coverage *= EvaluateCoverageNoise(positionWS.xz);
        if (hasBiomes)
        {
            coverage *= saturate(biomeGrass.densityMultiplier / max(0.0001, densityCapacityMultiplier));
        }

        coverage = saturate(coverage);

        if (coverage <= 0.0 || Hash01(instanceHash + 0x3c6ef372u) > coverage)
        {
            continue;
        }

        uint writeIndex;
        InterlockedAdd(_GrassCounter[0], 1u, writeIndex);
        if (writeIndex >= (uint)_GrassCapacity)
        {
            continue;
        }

        float bladeHeight = lerp(
            minBladeHeight,
            maxBladeHeight,
            Hash01(instanceHash + 0xa54ff53au)) * biomeGrass.bladeHeightMultiplier;
        float bladeWidth = lerp(
            minBladeWidth,
            maxBladeWidth,
            Hash01(instanceHash + 0x510e527fu)) * biomeGrass.bladeWidthMultiplier;
        float yaw = Hash01(instanceHash + 0x1f83d9abu) * 6.2831855;
        float colorScale = 1.0 + (Hash01(instanceHash + 0x5be0cd19u) * 2.0 - 1.0) * biomeGrass.colorVariation;
        float3 instanceBaseColor = max(float3(0.0, 0.0, 0.0), biomeGrass.grassBaseColor * colorScale);
        float3 instanceTipColor = max(float3(0.0, 0.0, 0.0), biomeGrass.grassTipColor * colorScale);
        float3 instanceNormal = normalize(lerp(float3(0.0, 1.0, 0.0), normalWS, _GrassNormalAlignment));
        positionWS.y += _GrassSurfaceOffset;

        GrassInstance instanceData;
        instanceData.positionScale = float4(positionWS, bladeHeight);
        instanceData.packed = uint4(
            PackNormalYaw(instanceNormal, yaw),
            PackColorWidth(instanceBaseColor, bladeWidth),
            PackColor(instanceTipColor),
            0u);
        _GrassInstances[writeIndex] = instanceData;
    }
}

[numthreads(1, 1, 1)]
void FinalizeGrassArgs(uint3 id : SV_DispatchThreadID)
{
    uint capacity = (uint)max(_GrassCapacity, 0);
    uint instanceCount = min(_GrassCounter[0], capacity);
    _GrassArgs[0] = (uint)max(_GrassDrawIndexCount, 0);
    _GrassArgs[1] = instanceCount;
    _GrassArgs[2] = (uint)max(_GrassDrawStartIndex, 0);
    _GrassArgs[3] = (uint)max(_GrassDrawBaseVertex, 0);
    _GrassArgs[4] = 0u;
}

[numthreads(1, 1, 1)]
void PrepareGrassCullArgs(uint3 id : SV_DispatchThreadID)
{
    _GrassArgs[0] = (uint)max(_GrassDrawIndexCount, 0);
    _GrassArgs[1] = 0u;
    _GrassArgs[2] = (uint)max(_GrassDrawStartIndex, 0);
    _GrassArgs[3] = (uint)max(_GrassDrawBaseVertex, 0);
    _GrassArgs[4] = 0u;
}

bool IsGrassInstanceInsideFrustum(float3 centerWS, float radius)
{
    if (_GrassFrustumCullingEnabled == 0)
    {
        return true;
    }

    [unroll]
    for (int i = 0; i < 6; i++)
    {
        float4 plane = _GrassFrustumPlanes[i];
        if (dot(plane.xyz, centerWS) + plane.w < -radius)
        {
            return false;
        }
    }

    return true;
}

bool IsGrassInstanceVisible(GrassInstance instanceData)
{
    float height = max(0.01, instanceData.positionScale.w);
    float width = UnpackWidth(instanceData.packed.y);
    float radius = max(height * 0.55, width * 1.5);
    float3 centerWS = instanceData.positionScale.xyz + float3(0.0, height * 0.5, 0.0);
    float maxDistance = max(_FadeDistances.y, 0.0) + radius;
    float2 viewerDelta = centerWS.xz - _ViewerPosition.xz;
    if (dot(viewerDelta, viewerDelta) > maxDistance * maxDistance)
    {
        return false;
    }

    return IsGrassInstanceInsideFrustum(centerWS, radius);
}

void AppendVisibleGrassInstance(GrassInstance instanceData, uint outputCapacity)
{
    if (!IsGrassInstanceVisible(instanceData))
    {
        return;
    }

    uint writeIndex;
    InterlockedAdd(_GrassArgs[1], 1u, writeIndex);
    if (writeIndex < outputCapacity)
    {
        _GrassVisibleInstances[writeIndex] = instanceData;
    }
}

[numthreads(64, 1, 1)]
void CullGrassInstances(uint3 id : SV_DispatchThreadID)
{
    uint capacity = (uint)max(_GrassCapacity, 0);
    if (capacity == 0)
    {
        return;
    }

    uint sourceCount = min(_GrassCounter[0], capacity);
    uint sourceIndex = id.x;
    if (sourceIndex >= sourceCount)
    {
        return;
    }

    GrassInstance instanceData = _GrassInstances[sourceIndex];
    AppendVisibleGrassInstance(instanceData, capacity);
}

[numthreads(64, 1, 1)]
void CopyGrassInstancesToCluster(uint3 id : SV_DispatchThreadID)
{
    uint sourceCapacity = (uint)max(_GrassCapacity, 0);
    uint sourceCount = min(_GrassCounter[0], sourceCapacity);
    uint clusterCapacity = (uint)max(_GrassClusterCapacity, 0);
    uint cellIndex = (uint)max(_GrassClusterCellIndex, 0);
    uint cellCapacity = (uint)max(_GrassClusterCellCapacity, 0);
    uint writeOffset = (uint)max(_GrassClusterWriteOffset, 0);

    if (id.x == 0 && cellIndex < (uint)max(_GrassClusterCellCount, 0))
    {
        _GrassClusterCellCounts[cellIndex] = min(sourceCount, cellCapacity);
    }

    if (id.x >= sourceCount || id.x >= cellCapacity)
    {
        return;
    }

    uint writeIndex = writeOffset + id.x;
    if (writeIndex < clusterCapacity)
    {
        _GrassClusterInstances[writeIndex] = _GrassInstances[id.x];
    }
}

[numthreads(64, 1, 1)]
void CullGrassClusterInstances(uint3 id : SV_DispatchThreadID)
{
    uint clusterCapacity = (uint)max(_GrassClusterCapacity, 0);
    uint cellCapacity = (uint)max(_GrassClusterCellCapacity, 0);
    uint cellCount = (uint)max(_GrassClusterCellCount, 0);
    if (clusterCapacity == 0 || cellCapacity == 0 || cellCount == 0)
    {
        return;
    }

    uint sourceIndex = id.x;
    if (sourceIndex >= clusterCapacity)
    {
        return;
    }

    uint cellIndex = sourceIndex / cellCapacity;
    if (cellIndex >= cellCount)
    {
        return;
    }

    uint localIndex = sourceIndex - cellIndex * cellCapacity;
    uint sourceCount = min(_GrassClusterCellCounts[cellIndex], cellCapacity);
    if (localIndex >= sourceCount)
    {
        return;
    }

    GrassInstance instanceData = _GrassClusterInstances[sourceIndex];
    AppendVisibleGrassInstance(instanceData, clusterCapacity);
}
